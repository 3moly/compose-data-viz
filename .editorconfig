root = true

[sample/**]
ktlint = disabled

[build-tools/**]
ktlint = disabled

[*.{kt,kts}]
ktlint_code_style = ktlint_official
ktlint_standard_filename = disabled
ktlint_function_naming_ignore_when_annotated_with = Composable
ktlint_standard_no-unused-imports = enabled


# Ignore all generated build files globally
[**/build/**]
ktlint = disabled

# Alternatively, target the specific Compose Multiplatform generated folder
[**/generated/compose/**]
ktlint = disabled

[*.gradle.kts]
# Disable the custom raw string rule specifically for Gradle build scripts
custom_raw-string-rule = disabled